---
import { mdiArrowLeft, mdiArrowRight, mdiCheckBold, mdiOpenInNew } from '@mdi/js';

const certificates = [
  {
    title: 'Introduction to Cyber Security',
    issuer: 'Komdigi Digital Talent Scholarship',
    year: '2025',
    preview: '/assets/certificates/cyber-security-awareness.webp',
    document: '/assets/certificates/cyber-security-awareness.pdf',
  },
  {
    title: 'Praktikum Data Mining',
    issuer: 'Laboratorium Teknik Informatika UPB',
    year: '2026',
    preview: '/assets/certificates/data-mining-practicum.webp',
    document: '/assets/certificates/data-mining-practicum.png',
  },
  {
    title: 'Praktik Kerja Lapangan',
    issuer: 'Dinas Arsip dan Perpustakaan Kabupaten Bekasi',
    year: '2026',
    preview: '/assets/certificates/library-internship.webp',
    document: '/assets/certificates/library-internship.pdf',
  },
  {
    title: 'Seminar Nasional Data & AI',
    issuer: 'Asosiasi Riset Ilmu Matematika dan Sains Indonesia',
    year: '2026',
    preview: '/assets/certificates/national-data-ai-seminar.webp',
    document: '/assets/certificates/national-data-ai-seminar.png',
  },
  {
    title: 'Panitia Seminar Web Development & API',
    issuer: 'Program Studi Teknik Informatika Universitas Pelita Bangsa',
    year: '2025',
    preview: '/assets/certificates/web-development-api-committee.webp',
    document: '/assets/certificates/web-development-api-committee.pdf',
  },
  {
    title: 'Seminar Keamanan Informasi',
    issuer: 'Universitas Pelita Bangsa',
    year: '2024',
    preview: '/assets/certificates/information-security-seminar.webp',
    document: '/assets/certificates/information-security-seminar.pdf',
  },
  {
    title: 'Seminar Technopreneur & SDGs',
    issuer: 'Fakultas Teknik Universitas Pelita Bangsa',
    year: '2024',
    preview: '/assets/certificates/technopreneur-sdgs-seminar.webp',
    document: '/assets/certificates/technopreneur-sdgs-seminar.pdf',
  },
  {
    title: 'Seminar Evolusi Teknologi Web',
    issuer: 'Program Studi Teknik Informatika Universitas Pelita Bangsa',
    year: '2024',
    preview: '/assets/certificates/web-evolution-seminar.webp',
    document: '/assets/certificates/web-evolution-seminar.pdf',
  },
  {
    title: 'Seminar Fisika & Robotika',
    issuer: 'Program Studi Teknik Informatika Universitas Pelita Bangsa',
    year: '2024',
    preview: '/assets/certificates/physics-robotics-seminar.webp',
    document: '/assets/certificates/physics-robotics-seminar.png',
  },
];
---

<section aria-labelledby="certificatesTitle" class="section certificates" id="certificates">
  <div class="container">
    <header class="certificates-head" data-reveal>
      <p class="section-kicker">Sertifikat & pencapaian</p>
      <h2 id="certificatesTitle">Dokumentasi proses belajar yang terus berkembang.</h2>
      <p>
        Pelatihan, praktik, kompetisi, dan forum akademik yang memperkuat dasar engineering saya.
      </p>
    </header>
  </div>

  <div class="certificate-viewport" aria-label="Daftar sertifikat" id="certificateViewport">
    <div class="certificate-grid">
      {
        certificates.map((certificate, index) => (
          <a
            aria-label={`Buka sertifikat ${certificate.title}`}
            class="certificate-card"
            data-reveal="scale"
            href={certificate.document}
            rel="noreferrer"
            style={`--certificate-index:${index}`}
            target="_blank"
          >
            <figure class="certificate-preview">
              <img
                alt={`Sertifikat ${certificate.title} atas nama Irsyad`}
                decoding="async"
                height="905"
                loading="lazy"
                src={certificate.preview}
                width="1280"
              />
            </figure>
            <div class="certificate-body">
              <div class="certificate-meta">
                <span class="certificate-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={mdiCheckBold}></path></svg>
                </span>
                <span>
                  {String(index + 1).padStart(2, '0')} /{' '}
                  {String(certificates.length).padStart(2, '0')}
                </span>
                <time>{certificate.year}</time>
              </div>
              <h3>{certificate.title}</h3>
              <p>{certificate.issuer}</p>
              <span class="certificate-link">
                Lihat sertifikat
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiOpenInNew}></path></svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div
    aria-label="Navigasi sertifikat"
    class="mobile-slider-nav certificate-slider-nav"
    data-mobile-slider-nav
    data-slider-items=".certificate-card"
    data-slider-target="certificateViewport"
  >
    <button aria-label="Sertifikat sebelumnya" class="mobile-slider-button" data-slider-prev disabled title="Sebelumnya" type="button">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiArrowLeft}></path></svg>
    </button>
    <span aria-live="polite" class="mobile-slider-counter">
      <strong data-slider-current>01</strong> / {String(certificates.length).padStart(2, '0')}
    </span>
    <button aria-label="Sertifikat berikutnya" class="mobile-slider-button" data-slider-next title="Berikutnya" type="button">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiArrowRight}></path></svg>
    </button>
  </div>
</section>
