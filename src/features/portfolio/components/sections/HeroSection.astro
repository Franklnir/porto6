---
import ResponsivePicture from '@/components/media/ResponsivePicture.astro';
import { mdiFacebook, mdiGithub, mdiInstagram, mdiLinkedin, mdiWhatsapp } from '@mdi/js';
import profilePhoto from '@/assets/images/profile/irsyad-profile-master.jpg';
import { siteConfig } from '@/config/site';
---
<section aria-labelledby="heroTitle" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-greeting" data-hero="">Hello There!</p>
      <h1 data-hero="" id="heroTitle">I'm <span class="hero-name-lock"><span class="text-blue">Irsyad</span>,</span>
        <span class="hero-title-role">a Web and IoT Developer.</span>
      </h1>
      <p class="hero-intro" data-hero="">Saya tertarik pada proyek yang menghubungkan perangkat, backend, data flow, antarmuka, dan AI menjadi satu solusi operasional yang jelas. Bagi saya, engineering bukan hanya membuat fitur selesai, tetapi memastikan sistem dapat dipahami, diamati, diuji, dan ditingkatkan.</p>
      <div class="hero-actions" data-hero="">
        <a class="btn btn-dark magnetic" href="#projects"><span>Lihat proyek</span><span class="arrow">→</span></a>
        <a class="btn magnetic" href="[CV_URL]"><span>Unduh CV</span><span class="arrow">↓</span></a>
      </div>
      <nav aria-label="Media sosial Irsyad" class="hero-socials" data-hero="">
        <a aria-label="GitHub Irsyad" class="hero-social-link" href={siteConfig.links.github} rel="noreferrer" target="_blank" title="GitHub">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiGithub}></path></svg>
        </a>
        <a aria-label="Instagram Irsyad" class="hero-social-link" href={siteConfig.links.instagram} rel="noreferrer" target={siteConfig.links.instagram.startsWith('http') ? '_blank' : undefined} title="Instagram">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiInstagram}></path></svg>
        </a>
        <a aria-label="LinkedIn Irsyad" class="hero-social-link" href={siteConfig.links.linkedin} rel="noreferrer" target={siteConfig.links.linkedin.startsWith('http') ? '_blank' : undefined} title="LinkedIn">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiLinkedin}></path></svg>
        </a>
        <a aria-label="Facebook Irsyad" class="hero-social-link" href={siteConfig.links.facebook} rel="noreferrer" target={siteConfig.links.facebook.startsWith('http') ? '_blank' : undefined} title="Facebook">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiFacebook}></path></svg>
        </a>
        <a aria-label="WhatsApp Irsyad" class="hero-social-link" href={siteConfig.links.whatsapp} rel="noreferrer" target="_blank" title="WhatsApp">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d={mdiWhatsapp}></path></svg>
        </a>
      </nav>
    </div>
    <div aria-label="Foto profil Irsyad" class="hero-visual">
      <div class="profile-slot profile-slot--hero" id="profileHeroSlot">
        <div class="photo-wrap" id="heroPhoto">
          <ResponsivePicture
            src={profilePhoto}
            alt="Irsyad, IoT, AI, dan Full-Stack Systems Engineer"
            width={450}
            height={654}
            quality={82}
            priority
            position="50% 18%"
            class="profile-photo"
          />
        </div>
      </div>
      <div class="photo-card"><span>Current focus</span><strong>IoT, platform engineering, dan integrasi sistem AI.</strong></div>
      <div aria-hidden="true" class="orbit">
        <svg viewBox="0 0 100 100"><defs><path d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" id="circlePath"></path></defs><text font-family="IBM Plex Mono" font-size="8" letter-spacing="2"><textPath href="#circlePath">BUILD · TEST · MEASURE · ITERATE · </textPath></text></svg><b>↗</b>
      </div>
    </div>
  </div>
</section>
