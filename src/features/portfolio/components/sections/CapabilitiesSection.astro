---
import { mdiApplicationBracesOutline, mdiMemory, mdiRobotOutline } from '@mdi/js';

const capabilities = [
  {
    index: '01',
    label: 'CONNECTED SYSTEMS',
    accent: '#1858ee',
    icon: mdiMemory,
    title: 'IoT & Embedded Engineering',
    description:
      'Merancang sistem berbasis sensor, perangkat, komunikasi, dan telemetri yang terhubung dengan backend atau aplikasi.',
    items: [
      'ESP32 / Sensor Integration / SBC',
      'MQTT / Mosquitto',
      'RFID / Sensors',
      'Camera / Relay / Actuator',
    ],
  },
  {
    index: '02',
    label: 'APPLICATION SYSTEMS',
    accent: '#111111',
    icon: mdiApplicationBracesOutline,
    title: 'Backend & Platform Engineering',
    description:
      'Membangun backend, API, database, dan layanan real-time yang terstruktur, aman, serta mudah dikembangkan dan dipelihara.',
    items: [
      'Laravel / FastAPI',
      'PostgreSQL / MySQL / Redis',
      'REST API / Queue',
      'WebSocket / Worker',
    ],
  },
  {
    index: '03',
    label: 'INTELLIGENT SYSTEMS',
    accent: '#1858ee',
    icon: mdiRobotOutline,
    title: 'AI System Integration',
    description:
      'Mengintegrasikan model AI, computer vision, AI agent, dan tools ke dalam sistem untuk menyelesaikan kebutuhan operasional.',
    items: [
      'AI Models / Hugging Face',
      'MCP / Tool Integration',
      'Computer Vision / Automation',
      'AI Agent Integration',
    ],
  },
];
---

<section aria-labelledby="servicesTitle" class="section services-lookbook" data-services-lookbook id="services">
  <div class="container">
    <header class="section-head services-lookbook-head" data-reveal>
      <p class="section-kicker">Kapabilitas</p>
      <div>
        <h2 id="servicesTitle">Merancang sistem dari perangkat hingga platform operasional.</h2>
        <p class="lede">
          Device &amp; Sensor → Backend &amp; Data → AI &amp; Automation. Tiga area ini membentuk satu
          alur engineering yang terhubung dari perangkat hingga sistem operasional.
        </p>
        <div aria-hidden="true" class="services-scroll-status">
          <span>SCROLL TO REVEAL</span>
          <i><b data-services-progress></b></i>
          <span>01 - 03</span>
        </div>
      </div>
    </header>

    <div class="services services-lookbook-grid">
      {
        capabilities.map((capability, index) => (
          <article
            class="service-card"
            data-look-card
            data-look-index={capability.index}
            data-reveal
            style={`--delay:${index * 90}ms;--look-accent:${capability.accent}`}
          >
            <div class="service-no">
              <span>{capability.index} / {capability.label}</span>
              <span class="service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={capability.icon}></path></svg>
              </span>
            </div>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <ul class="service-list">
              {capability.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
