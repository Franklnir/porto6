---
import { mdiMicrosoftVisualStudioCode } from '@mdi/js';
import {
  siArduino,
  siDeepseek,
  siDiagramsdotnet,
  siEspressif,
  siGooglegemini,
  siGooglesheets,
  siQwen,
  siTinkercad,
} from 'simple-icons';

type ToolIcon = { path: string; viewBox?: string } | { src: string };

type Tool = {
  name: string;
  accent: string;
  icon: ToolIcon;
  variant?: 'is-solid' | 'is-blue';
};

type ToolRow = {
  speed: string;
  reverse?: boolean;
  tools: Tool[];
};

const rows: ToolRow[] = [
  {
    speed: '36s',
    tools: [
      {
        name: 'ChatGPT',
        accent: '#111111',
        icon: { src: '/assets/brands/openai.svg' },
        variant: 'is-solid',
      },
      {
        name: 'Google Gemini',
        accent: `#${siGooglegemini.hex}`,
        icon: { path: siGooglegemini.path },
      },
      { name: 'OpenAI Codex', accent: '#111111', icon: { src: '/assets/brands/openai.svg' } },
      {
        name: 'Google Antigravity',
        accent: '#1858EE',
        icon: { src: '/assets/brands/google-antigravity.png' },
        variant: 'is-blue',
      },
      { name: 'OpenAI API', accent: '#111111', icon: { src: '/assets/brands/openai.svg' } },
    ],
  },
  {
    speed: '40s',
    reverse: true,
    tools: [
      { name: 'Arduino IDE', accent: `#${siArduino.hex}`, icon: { path: siArduino.path } },
      {
        name: 'ESP-IDF',
        accent: `#${siEspressif.hex}`,
        icon: { path: siEspressif.path },
        variant: 'is-solid',
      },
      {
        name: 'Visual Studio Code',
        accent: '#007ACC',
        icon: { path: mdiMicrosoftVisualStudioCode },
      },
      {
        name: 'Google Sheets',
        accent: `#${siGooglesheets.hex}`,
        icon: { path: siGooglesheets.path },
      },
      {
        name: 'Autodesk Tinkercad',
        accent: `#${siTinkercad.hex}`,
        icon: { path: siTinkercad.path },
        variant: 'is-solid',
      },
    ],
  },
  {
    speed: '44s',
    tools: [
      {
        name: 'DeepSeek',
        accent: `#${siDeepseek.hex}`,
        icon: { path: siDeepseek.path },
        variant: 'is-blue',
      },
      { name: 'Qwen', accent: `#${siQwen.hex}`, icon: { path: siQwen.path } },
      {
        name: 'Comet',
        accent: '#147CE5',
        icon: { src: '/assets/brands/comet.png' },
        variant: 'is-solid',
      },
      { name: '9Router', accent: '#E68A6E', icon: { src: '/assets/brands/9router.svg' } },
      { name: 'Graphify', accent: '#2D8C5A', icon: { src: '/assets/brands/graphify.png' } },
      {
        name: 'diagrams.net (draw.io)',
        accent: `#${siDiagramsdotnet.hex}`,
        icon: { path: siDiagramsdotnet.path },
        variant: 'is-solid',
      },
    ],
  },
];
---

<section aria-labelledby="myToolsTitle" class="my-tools-wrap" id="my-tools">
  <div id="myToolsPanel">
    <header class="my-tools-head" data-reveal>
      <div>
        <p class="my-tools-label">Toolkit / workflow</p>
        <h3 class="my-tools-title" id="myToolsTitle">My <em>Tools.</em></h3>
      </div>
      <div>
        <p class="my-tools-copy">
          Tool yang saya gunakan untuk merancang arsitektur, mengembangkan software, bereksperimen
          dengan embedded system, dan menjalankan workflow engineering berbantuan AI.
        </p>
      </div>
    </header>

    <div aria-label="Daftar tools yang digunakan" class="tool-streams">
      {
        rows.map((row) => (
          <div
            class:list={['tool-row', { 'is-reverse': row.reverse }]}
            style={`--speed:${row.speed}`}
          >
            <div class="tool-flow">
              {[0, 1].map((setIndex) => (
                <div class="tool-set" aria-hidden={setIndex === 1 ? 'true' : undefined}>
                  {row.tools.map((tool, toolIndex) => (
                    <>
                      <div
                        class:list={['tool-pill', tool.variant]}
                        style={`--tool-accent:${tool.accent}`}
                      >
                        <span class="tool-icon">
                          {'src' in tool.icon ? (
                            <img alt="" aria-hidden="true" loading="lazy" src={tool.icon.src} />
                          ) : (
                            <svg aria-hidden="true" viewBox={tool.icon.viewBox ?? '0 0 24 24'}>
                              <path d={tool.icon.path} />
                            </svg>
                          )}
                        </span>
                        <span class="tool-word">
                          <span class="tool-word-track">
                            <span>{tool.name}</span>
                            <span aria-hidden="true">{tool.name}</span>
                          </span>
                        </span>
                      </div>
                      {toolIndex < row.tools.length - 1 && (
                        <span aria-hidden="true" class="tool-plus">
                          +
                        </span>
                      )}
                    </>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
