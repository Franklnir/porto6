---
import { Image } from 'astro:assets';
import { getProjectCover } from '../data/projectCovers';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const cover = getProjectCover(id);
---

<div class="project-route-visual" transition:name={`project-cover-${id}`}>
  {
    cover ? (
      <Image
        src={cover}
        alt={`Visual proyek ${title}`}
        widths={[480, 768, 1100, 1500]}
        sizes="(max-width: 720px) 92vw, min(100vw, 1440px)"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="project-route-fallback" aria-hidden="true" />
    )
  }
</div>

<style>
  .project-route-visual {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #111;
    min-height: 0;
  }
  .project-route-visual :global(img) {
    display: block;
    width: 100%;
    height: clamp(360px, 56vw, 760px);
    object-fit: contain;
    object-position: center;
    image-rendering: auto;
  }
  .project-route-fallback {
    min-height: 560px;
    background: linear-gradient(135deg, #1858ee, #101010);
  }
  @media (max-width: 620px) {
    .project-route-visual :global(img) {
      height: min(112vw, 570px);
    }
  }
</style>
