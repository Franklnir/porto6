---
// Navbar.astro - Neo-brutalist sticky navbar with desktop pill and mobile menu
import { siteConfig } from '../data/siteConfig';

const navItems = siteConfig.navItems;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

// Format href so subpages can jump to home anchors seamlessly
const resolveHref = (href: string) => {
  if (href.startsWith('#')) {
    return isHome ? href : `/${href}`;
  }
  return href;
};
---
<nav class="navbar" id="navbar" aria-label="Navigasi utama">
  <a href={isHome ? '#home' : '/'} class="navbar-brand" aria-label="Xichi — Beranda">
    <div class="brand-badge">
      <img src="/assets/logoxichi.jpg" alt="Logo Xichi AI" class="brand-badge-img" />
    </div>
    <span class="brand-title">XICHI</span>
  </a>

  <div class="nav-pill" role="navigation">
    {
      navItems.map((item, idx) => {
        const href = resolveHref(item.href);
        const isActive = isHome ? idx === 0 : currentPath === item.href;
        return (
          <a href={href} class={isActive ? 'active' : ''} data-section={item.sectionId}>
            {item.label}
          </a>
        );
      })
    }
  </div>

  <div class="nav-right">
    <!-- Theme Switcher Control -->
    <div class="theme-control">
      <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        data-theme-toggle
        aria-controls="themePicker"
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="Pilih tema tampilan"
        title="Pilih tema tampilan"
      >
        <span aria-hidden="true" class="theme-option-swatch theme-current-swatch">
          <i></i><i></i><i></i>
        </span>
        <span class="theme-label-text">Tema</span>
      </button>

      <div
        class="theme-options header-theme-picker"
        id="themePicker"
        data-theme-picker
        role="menu"
        aria-label="Pilihan tema tampilan"
      >
        <button
          type="button"
          role="menuitemradio"
          data-theme-option="dark"
          aria-checked="true"
        >
          <span aria-hidden="true" class="theme-option-swatch theme-option-swatch--dark">
            <i></i><i></i><i></i>
          </span>
          <span>Cyber Dark</span>
        </button>

        <button
          type="button"
          role="menuitemradio"
          data-theme-option="brand"
          aria-checked="false"
        >
          <span aria-hidden="true" class="theme-option-swatch theme-option-swatch--brand">
            <i></i><i></i><i></i>
          </span>
          <span>Brand Ink</span>
        </button>
      </div>
    </div>

    <button class="hamburger" id="hamburger" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobileMenu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Mobile Drawer Menu -->
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menu navigasi mobile">
  {
    navItems.map((item) => (
      <a href={resolveHref(item.href)} class="mobile-link">
        {item.label}
      </a>
    ))
  }

  <div class="mobile-theme-row">
    <span class="mobile-theme-title">GAYA TEMA</span>
    <div class="mobile-theme-options">
      <button type="button" class="mobile-theme-btn" data-theme-option="dark" aria-label="Aktifkan tema Cyber Dark">
        <span aria-hidden="true" class="theme-option-swatch theme-option-swatch--dark">
          <i></i><i></i><i></i>
        </span>
        <span>Cyber Dark</span>
      </button>
      <button type="button" class="mobile-theme-btn" data-theme-option="brand" aria-label="Aktifkan tema Brand Ink">
        <span aria-hidden="true" class="theme-option-swatch theme-option-swatch--brand">
          <i></i><i></i><i></i>
        </span>
        <span>Brand Ink</span>
      </button>
    </div>
  </div>
</div>

<script>
  // Theme Controller
  type Theme = 'dark' | 'brand';
  const STORAGE_KEY = 'xichi-theme';
  const root = document.documentElement;
  const themeToggle = document.getElementById('themeToggle');
  const themePicker = document.getElementById('themePicker');
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const themeColorMeta = document.getElementById('themeColor') as HTMLMetaElement | null;

  const themeColors: Record<Theme, string> = {
    dark: '#FFE600',
    brand: '#f5ecdc',
  };

  const updateControls = (theme: Theme) => {
    themeToggle?.setAttribute('data-current-theme', theme);
    themeToggle?.setAttribute('title', `Tema aktif: ${theme === 'brand' ? 'Brand Ink' : 'Cyber Dark'}`);
    themeButtons.forEach((btn) => {
      const isCurrent = btn.dataset.themeOption === theme;
      btn.setAttribute('aria-checked', String(isCurrent));
      btn.classList.toggle('active', isCurrent);
    });
  };

  const applyTheme = (theme: Theme, persist = false) => {
    root.dataset.theme = theme;
    if (themeColorMeta) {
      themeColorMeta.setAttribute('content', themeColors[theme]);
    }
    updateControls(theme);
    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        // Fallback gracefully if storage is restricted
      }
    }
  };

  // Sync initial theme
  const initialTheme = (root.dataset.theme === 'brand' ? 'brand' : 'dark') as Theme;
  applyTheme(initialTheme, false);

  // Toggle dropdown picker
  themeToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = themePicker?.classList.toggle('open');
    themeToggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Handle option select from both header dropdown & mobile menu
  themeButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const selected = btn.dataset.themeOption as Theme;
      if (selected === 'brand' || selected === 'dark') {
        applyTheme(selected, true);
        themePicker?.classList.remove('open');
        themeToggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (themePicker && !themePicker.contains(e.target as Node) && !themeToggle?.contains(e.target as Node)) {
      themePicker.classList.remove('open');
      themeToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close dropdown on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && themePicker?.classList.contains('open')) {
      themePicker.classList.remove('open');
      themeToggle?.setAttribute('aria-expanded', 'false');
      themeToggle?.focus();
    }
  });

  // Navbar scroll & mobile menu handling
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-pill a');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-link');

  // Shrink navbar on scroll
  window.addEventListener(
    'scroll',
    () => {
      if (navbar) {
        navbar.classList.toggle('scrolled', window.scrollY > 40);
      }
    },
    { passive: true }
  );

  // Toggle mobile menu
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('active');
      hamburger.classList.toggle('active', open);
      hamburger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    });

    // Close when clicking link
    mobileLinks.forEach((l) => {
      l.addEventListener('click', () => {
        hamburger.classList.remove('active');
        mobileMenu.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }

  // Active pill link on scroll & subpage handling
  const sectionMapping: Record<string, string> = {
    home: 'home',
    products: 'products',
    culture: 'products',
    voice: 'tools',
    tools: 'tools',
    compare: 'tools',
    chronchi: 'tools',
    about: 'about',
    pengadaan: 'pengadaan',
    faq: 'faq',
    contact: 'pengadaan',
  };

  const isTentangPage = window.location.pathname.replace(/\/$/, '').endsWith('tentang');

  if (isTentangPage) {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      link.classList.toggle('active', href?.includes('tentang') || false);
    });
  } else {
    const sectionIds = Object.keys(sectionMapping);
    window.addEventListener(
      'scroll',
      () => {
        let currentSection = 'home';
        sectionIds.forEach((id) => {
          const el = document.getElementById(id);
          if (el && window.scrollY >= el.offsetTop - 240) {
            currentSection = id;
          }
        });
        const activeNavKey = sectionMapping[currentSection] || currentSection;
        navLinks.forEach((link) => {
          const target = link.getAttribute('href')?.replace('#', '');
          link.classList.toggle('active', target === activeNavKey);
        });
      },
      { passive: true }
    );
  }
</script>
