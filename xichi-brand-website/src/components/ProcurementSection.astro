---
// ProcurementSection.astro - 08 / Pengadaan & Kerjasama (WARNA: KUNING 🟡)
import { siteConfig } from '../data/siteConfig';

const contactWhatsappMessage = encodeURIComponent(
  'Halo tim Xichi AI Studio!\nSaya tertarik untuk konsultasi pengadaan unit / kerjasama perangkat Xichi AI.\n\nInstansi/Komunitas: \nKebutuhan Unit: \nMohon informasi ketersediaan. Terima kasih!'
);
---

<section class="procurement-section" id="pengadaan">
  <header class="section-header dark">
    <p>08 / Pengadaan & Kerjasama</p>
    <h2>
      <span class="word"><span>SOLUSI</span></span>{' '}
      <span class="word"><span>UNTUK</span></span>{' '}
      <span class="word"><span>KAMPUS,</span></span>{' '}
      <span class="word"><span>SEKOLAH</span></span>{' '}
      <span class="word"><span>&</span></span>{' '}
      <span class="word"><span>KANTOR.</span></span>
    </h2>
  </header>

  <div class="procurement-container">
    <!-- Explainer Banner (White brutalist card on yellow) -->
    <div class="procurement-banner">
      <div class="banner-icon">📦</div>
      <div class="banner-text">
        <h3>Pengadaan Mudah untuk Institusi & Komunitas</h3>
        <p>
          Ingin memesan perangkat <strong>Xichi AI</strong> dalam jumlah tertentu untuk <strong>laboratorium praktikum kampus, SMK vokasi, workshop maker, perkantoran, maupun komunitas</strong>? Xichi AI Studio melayani pengadaan unit siap pakai, paket komponen mandiri, modul ajar praktikum, dan pendampingan teknis langsung dari engineer pembuatnya.
        </p>
      </div>
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${contactWhatsappMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-banner-wa"
      >
        <span>Diskusi Pengadaan</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- 4 Offering Grid (Crisp white cards with bold black borders & shadows) -->
    <div class="procurement-grid">
      <div class="proc-card">
        <div class="proc-num">01</div>
        <span class="proc-cat">EDUKASI & PRAKTIKUM</span>
        <h4 class="proc-title">Lab Starter Pack: Kampus & SMK Vokasi</h4>
        <p class="proc-desc">
          Pengadaan unit kit riset Xichi untuk laboratorium IoT, teknik komputer, mekatronika, dan sains data.
        </p>
        <ul class="proc-bullets">
          <li>✓ Unit siap pakai atau kit komponen edukasi perakitan mandiri</li>
          <li>✓ Skema rangkaian, source code firmware C++/ESP-IDF, dan panduan praktikum</li>
          <li>✓ Sesi workshop teknis langsung bersama lead engineer Xichi AI</li>
        </ul>
        <div class="proc-badge">Target: Universitas, Institut Teknologi, SMK Vokasi</div>
      </div>

      <div class="proc-card popular">
        <div class="popular-ribbon">POPULER</div>
        <div class="proc-num red">02</div>
        <span class="proc-cat">KANTOR & PRODUKTIVITAS</span>
        <h4 class="proc-title">Custom Voice AI untuk Meja Kerja Kantor</h4>
        <p class="proc-desc">
          Asisten suara fisik personal untuk meja kerja direksi, studio startup, atau front desk kantor modern.
        </p>
        <ul class="proc-bullets">
          <li>✓ Penyesuaian basis pengetahuan khusus dokumen SOP perusahaan</li>
          <li>✓ Integrasi ke bot notifikasi meeting & monitoring status server internal</li>
          <li>✓ Privasi terjamin dengan isolasi data dan kendali lokal</li>
        </ul>
        <div class="proc-badge">Target: Startup, Studio Desain, Coworking, Kantor Modern</div>
      </div>

      <div class="proc-card">
        <div class="proc-num">03</div>
        <span class="proc-cat">VISION AI & MULTIMODAL</span>
        <h4 class="proc-title">Vision AI & Analitik Visual Cerdas</h4>
        <p class="proc-desc">
          Integrasi kamera cerdas OV2640 untuk membaca teks dokumen (OCR), inspeksi meja kerja, dan analisis objek interaktif.
        </p>
        <ul class="proc-bullets">
          <li>✓ Unit Xichi Vision Pro dengan lensa terkalibrasi presisi</li>
          <li>✓ Pipeline analisis visual lokal berdaya rendah ESP32-S3</li>
          <li>✓ Kompatibel dengan sistem inspeksi lab dan kurikulum computer vision</li>
        </ul>
        <div class="proc-badge">Target: Lab Riset, Kampus Vokasi, Kios Cerdas Modern</div>
      </div>

      <div class="proc-card">
        <div class="proc-num">04</div>
        <span class="proc-cat">KUSTOMISASI MERK</span>
        <h4 class="proc-title">OEM & Casing Branding Khusus</h4>
        <p class="proc-desc">
          Produksi unit asisten AI fisik dengan penyesuaian bentuk casing, logo merk klien, dan persona suara kustom.
        </p>
        <ul class="proc-bullets">
          <li>✓ Casing presisi 3D print berlogo identitas instansi Anda</li>
          <li>✓ Pembuatan wake-word / sapaan nama khusus instansi</li>
          <li>✓ Cinderamata teknologi eksklusif untuk mitra VIP</li>
        </ul>
        <div class="proc-badge">Target: Brand Korporat, Event Teknologi, Komunitas Eksekutif</div>
      </div>
    </div>
  </div>
</section>

<style>
  .procurement-section {
    padding: clamp(60px, 8vw, 100px) clamp(20px, 4vw, 40px);
    background: #FFE600 !important;
    color: #000000;
    border-top: 4px solid var(--black, #000);
    border-bottom: 4px solid var(--black, #000);
    position: relative;
    overflow: hidden;
  }

  .procurement-section .section-header.dark p {
    color: var(--yellow, #FFE600) !important;
    background: var(--black, #000) !important;
    border: 2px solid var(--black, #000) !important;
  }

  .procurement-section .section-header.dark h2,
  .procurement-section .section-header.dark h2 .word > span {
    color: #000000 !important;
  }

  .procurement-container {
    max-width: 1200px;
    margin: 40px auto 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Explainer Banner */
  .procurement-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: #ffffff;
    border: 3px solid #000000;
    box-shadow: 6px 6px 0 #000000;
    padding: 24px 28px;
  }

  .banner-icon {
    font-size: 38px;
    line-height: 1;
    flex-shrink: 0;
  }

  .banner-text {
    flex: 1;
  }

  .banner-text h3 {
    font-size: clamp(17px, 2.2vw, 20px);
    font-weight: 900;
    color: #000000;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .banner-text p {
    font-size: 14px;
    color: #262626;
    line-height: 1.6;
  }

  .banner-text strong {
    color: #000000;
    font-weight: 800;
  }

  .btn-banner-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #000000;
    color: var(--yellow, #FFE600);
    font-size: 13.5px;
    font-weight: 900;
    text-decoration: none;
    border: 2px solid #000000;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn-banner-wa:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.5);
  }

  /* 4 Offering Grid */
  .procurement-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .proc-card {
    background: #ffffff;
    border: 3px solid #000000;
    box-shadow: 5px 5px 0 #000000;
    padding: 28px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .proc-card:hover {
    border-color: #000000;
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 #000000;
  }

  .proc-card.popular {
    border-color: var(--red, #FF3B30);
  }

  .popular-ribbon {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--red, #FF3B30);
    color: #fff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
  }

  .proc-num {
    font-size: 30px;
    font-weight: 900;
    color: #000000;
    line-height: 1;
    margin-bottom: 6px;
  }

  .proc-num.red {
    color: var(--red, #FF3B30);
  }

  .proc-cat {
    display: inline-block;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    background: #000000;
    color: var(--yellow, #FFE600);
    padding: 2px 8px;
    align-self: flex-start;
    margin-bottom: 10px;
    border: 1px solid #000;
  }

  .proc-title {
    font-size: 18px;
    font-weight: 900;
    color: #000000;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .proc-desc {
    font-size: 13.5px;
    color: #404040;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .proc-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .proc-bullets li {
    font-size: 13px;
    color: #171717;
    line-height: 1.5;
    font-weight: 500;
  }

  .proc-badge {
    padding: 6px 12px;
    background: #f5f5f5;
    border: 2px solid #000000;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 800;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .procurement-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .btn-banner-wa {
      width: 100%;
      justify-content: center;
    }

    .procurement-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
