---
// BaseLayout.astro - Master layout for Xichi AI Neo-Brutalist Brand Website
import '../styles/global.css';
import TopTape from '../components/TopTape.astro';
import Loader from '../components/Loader.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import PreorderModal from '../components/PreorderModal.astro';
import { siteConfig } from '../data/siteConfig';
import { hardwareProducts } from '../data/products';
import { faqItems } from '../data/faqs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : 'https://produk.irsyadlabs.id/',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://produk.irsyadlabs.id';
const imageUrl = new URL(image, siteUrl).href;

// 1. JSON-LD Organization
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Xichi AI',
  alternateName: [
    'Xiaozhi Indonesia',
    'Xiaozhi Indoensia',
    'IrsyadLabs AI',
    'xiaozhiscig',
    'Xichi Voice AI Assistant',
    'Asisten AI Fisik Indonesia',
    'Xichi Studio',
  ],
  url: siteUrl,
  logo: `${siteUrl}/assets/logoxichi.jpg`,
  description: description,
  founder: {
    '@type': 'Person',
    name: 'Franklnir',
    url: 'https://github.com/Franklnir',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'IrsyadLabs',
    url: 'https://irsyadlabs.id',
  },
  sameAs: [
    'https://irsyadlabs.id',
    'https://xiaozhiscig.biz.id',
    'https://github.com/Franklnir',
    'https://instagram.com/xichiaipendant',
    'https://tiktok.com/@xichiaipendant',
    'https://youtube.com/@xichiaipendant',
  ],
};

// 2. JSON-LD WebSite
const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Xichi — Xiaozhi Indonesia & Voice AI Assistant | IrsyadLabs',
  alternateName: [
    'Xiaozhi Indonesia',
    'Xiaozhi Indoensia',
    'Xichi AI',
    'IrsyadLabs AI',
    'xiaozhiscig',
    'Asisten AI Fisik',
    'Voice AI Indonesia',
  ],
  url: siteUrl,
  description: description,
  inLanguage: 'id-ID',
  publisher: {
    '@type': 'Organization',
    name: 'IrsyadLabs',
    url: 'https://irsyadlabs.id',
  },
};

// 3. JSON-LD Product & Offers
const jsonLdProduct = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Xichi Physical AI Assistant — Xiaozhi Indonesia (ESP32-S3 / C3)',
  alternateName: [
    'Xiaozhi Indonesia Hardware',
    'Voice AI Assistant Xichi',
    'Asisten AI Fisik IrsyadLabs',
    'xiaozhiscig AI companion',
  ],
  image: hardwareProducts.map((p) => `${siteUrl}${p.image || '/assets/products/xichi-core-render.webp'}`),
  description:
    'Perangkat keras asisten AI fisik dan Voice AI Xiaozhi Indonesia dari IrsyadLabs (xiaozhiscig). Dilengkapi suara interaktif bahasa Indonesia, layar ekspresi emosi dinamis, pemutar YouTube mandiri tanpa iklan, AI vision on-device, dan IoT smart home dual relay.',
  brand: {
    '@type': 'Brand',
    name: 'Xichi (Xiaozhi Indonesia by IrsyadLabs)',
  },
  keywords:
    'xiaozhi, xiaozhi indonesia, xiaozhi indoensia, ai asisten, asisten ai, voice ai, ai, irsyadlabs, xiaozhiscig, xichi, esp32-s3 ai',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'IDR',
    lowPrice: 300000,
    highPrice: 630000,
    offerCount: hardwareProducts.length,
    availability: 'https://schema.org/PreOrder',
    offers: hardwareProducts.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.priceValue,
      priceCurrency: 'IDR',
      availability: 'https://schema.org/PreOrder',
      url: `${siteUrl}#buy`,
    })),
  },
};

// 4. JSON-LD FAQPage
const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// 5. JSON-LD SoftwareApplication (Chronos App)
const jsonLdApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Chronos Companion App',
  operatingSystem: 'Android',
  applicationCategory: 'SmartHomeApplication',
  downloadUrl: 'https://play.google.com/store/apps/details?id=com.fbiego.chronos',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'IDR',
  },
};

// 6. JSON-LD BreadcrumbList
const jsonLdBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'IrsyadLabs',
      item: 'https://irsyadlabs.id',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Xiaozhi Indonesia (Produk)',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Xichi Voice AI Assistant',
      item: canonicalUrl,
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#FFE600" />
    <link rel="icon" type="image/jpeg" href="/assets/logoxichi.jpg" />
    <link rel="apple-touch-icon" href="/assets/logoxichi.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="xiaozhi, xiaozhi indonesia, xiaozhi indoensia, ai asisten, asisten ai, voice ai, ai, irsyadlabs, xiaozhiscig, xichi, xichi ai, esp32, esp32-s3, chronos app, robot meja ai, open source indonesia, voice engine ai"
    />
    <meta name="author" content="Franklnir • IrsyadLabs & Komunitas Xiaozhi Indonesia" />
    <meta name="publisher" content="IrsyadLabs" />
    <meta name="copyright" content="IrsyadLabs & Xichi Studio" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    <meta name="language" content="Indonesian" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Xichi — Xiaozhi Indonesia & Voice AI | IrsyadLabs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdApp)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />
  </head>
  <body>
    <TopTape />
    <Loader />
    <ScrollProgress />

    <slot />

    <PreorderModal />

    <script>
      // Global Intersection Observer for staggered scroll reveals
      const revealEls = document.querySelectorAll(
        '.product-card, .tool-card, .voice-item, .buy-card, .section-header, .bento-item, .footer-brand'
      );

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal', 'in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      revealEls.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
