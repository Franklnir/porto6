---
// tentang.astro - Halaman Resmi Company Profile & Kemitraan B2B / Institusi IrsyadLabs & Xichi Studio
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';

const b2bWhatsappMessage = encodeURIComponent(
  'Halo tim IrsyadLabs & Xichi Studio!\nSaya tertarik untuk mendiskusikan peluang kemitraan B2B / pengadaan institusi untuk perangkat Xichi AI.\n\nInstansi/Perusahaan: \nKebutuhan: \nMohon informasi lebih lanjut. Terima kasih!'
);
---

<BaseLayout
  title={`Tentang IrsyadLabs & Xichi Studio — Profil Perusahaan & Kemitraan B2B`}
  description="Profil resmi IrsyadLabs & Xichi Studio: Pelopor asisten AI fisik dan Voice AI berbasis ESP32 di Indonesia. Visi, misi, profil engineer, dan solusi kemitraan B2B/edukasi kampus."
>
  <Navbar />

  <main id="main-content" class="about-page">
    <!-- ========================================================
         HALAMAN 1: HERO & STATISTIK STUDIO (WARNA: KUNING 🟡)
         ======================================================== -->
    <section class="page-section section-yellow hero-section" id="hero">
      <div class="about-container">
        <!-- Badge Bar -->
        <div class="badge-row">
          <span class="brutal-badge badge-dark">PROFIL RESMI</span>
          <span class="brutal-badge badge-white">IRSYADLABS STUDIO</span>
          <span class="brutal-badge badge-red">SOLUSI B2B & RISET INSTITUSI</span>
        </div>

        <!-- Main Title -->
        <h1 class="hero-title">
          Membangun Masa Depan <span class="highlight-box">AI Fisik</span> di Indonesia.
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle">
          IrsyadLabs adalah studio riset rekayasa perangkat keras (hardware) dan kecerdasan buatan terapan di balik lahirnya <strong>Xichi</strong> — asisten AI fisik interaktif pertama dengan suara bahasa Indonesia alami, memori semantik percakapan, dan 47 MCP Superpower Tools.
        </p>

        <!-- Quick Jump Buttons -->
        <div class="hero-actions">
          <a href="#b2b" class="btn-brutal btn-black">
            <span>Pelajari Kemitraan B2B</span>
            <span class="arrow-icon" aria-hidden="true">↓</span>
          </a>
          <a href="#visi-misi" class="btn-brutal btn-white">
            <span>Visi & Misi Studio</span>
            <span class="arrow-icon" aria-hidden="true">↓</span>
          </a>
          <a href="/#products" class="btn-brutal btn-outline-dark">
            <span>Lihat Produk Xichi</span>
            <span class="arrow-icon" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Metric Stat Cards (Integrated in Yellow Section) -->
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">100%</span>
            <strong class="stat-title">Dirakit & Diprogram Lokal</strong>
            <p class="stat-caption">Riset skema sirkuit mikrokontroler mandiri dan manufaktur lab riset di Bandung.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">&lt;1.2s</span>
            <strong class="stat-title">Respon Audio Streaming</strong>
            <p class="stat-caption">Protokol audio streaming real-time berlatensi ultra-rendah dan kompresi Opus.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">47+</span>
            <strong class="stat-title">MCP Tools Terintegrasi</strong>
            <p class="stat-caption">Koneksi ke data BMKG, pencarian web, kontrol relay IoT, hingga pemutar YouTube.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">Bebas</span>
            <strong class="stat-title">Biaya Langganan Bulanan</strong>
            <p class="stat-caption">Didukung firmware open-source Xiaozhi dan aplikasi mobile Chronos BLE mandiri.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         HALAMAN 2: VISI & MISI STUDIO (WARNA: HITAM ⚫)
         ======================================================== -->
    <section class="page-section section-black" id="visi-misi">
      <div class="about-container">
        <div class="section-header">
          <span class="brutal-badge badge-yellow">01 / LANDASAN RISET</span>
          <h2 class="section-title text-light">Visi & Misi Studio IrsyadLabs</h2>
          <p class="section-desc text-muted">
            Prinsip dasar di balik setiap rancangan firmware, skema PCB mikrokontroler, dan arsitektur AI fisik yang kami bangun.
          </p>
        </div>

        <div class="vision-mission-grid">
          <!-- Visi Card -->
          <div class="dark-card vision-card">
            <div class="card-tag tag-yellow">VISI UTAMA</div>
            <h3 class="card-title text-light">Kedaulatan & Aksesibilitas Kecerdasan Buatan Fisik</h3>
            <p class="card-text text-stone">
              Mewujudkan era baru komputasi fisik (Physical AI) di mana setiap meja kerja, ruang praktikum kampus, dan kantor di Indonesia dapat memiliki asisten cerdas yang berinteraksi secara nyata, aman dari kebocoran privasi, dan bebas dari beban biaya langganan bulanan yang mahal.
            </p>

            <div class="dark-quote-box">
              <span class="quote-mark">“</span>
              <p>AI tidak seharusnya hanya terkunci di balik layar kaca smartphone, tetapi hadir secara berwujud nyata sebagai teman komputasi fisik di dunia sehari-hari.</p>
            </div>

            <div class="vision-perks">
              <div class="perk-item">
                <span class="perk-check">✓</span>
                <span><strong>Privasi Terjaga:</strong> Komputasi aman & kendali penuh atas data suara.</span>
              </div>
              <div class="perk-item">
                <span class="perk-check">✓</span>
                <span><strong>Bebas Tagihan Rutin:</strong> Perangkat keras milik pengguna seutuhnya.</span>
              </div>
              <div class="perk-item">
                <span class="perk-check">✓</span>
                <span><strong>Riset Mandiri:</strong> Dikembangkan langsung oleh pengembang independen lokal.</span>
              </div>
            </div>
          </div>

          <!-- Misi Card -->
          <div class="dark-card mission-card">
            <div class="card-tag tag-red">3 KOMITMEN REKAYASA</div>
            <h3 class="card-title text-light">Misi Studio untuk Indonesia</h3>

            <div class="mission-steps-list">
              <div class="mission-step-item">
                <div class="step-badge">01</div>
                <div class="step-content">
                  <h4 class="step-title">Demokratisasi Hardware Cerdas</h4>
                  <p class="step-desc">
                    Menghadirkan asisten AI fisik berbasis mikrokontroler ESP32-S3 hemat daya yang terjangkau bagi pelajar dan praktisi tanpa mengorbankan performa interaksi suara.
                  </p>
                </div>
              </div>

              <div class="mission-step-item">
                <div class="step-badge">02</div>
                <div class="step-content">
                  <h4 class="step-title">Pengembangan Ekosistem Open-Source Berdaulat</h4>
                  <p class="step-desc">
                    Mendukung riset komunitas Xiaozhi Indonesia, server mandiri xiaozhiscig, dan integrasi standar Model Context Protocol (MCP) agar teknologi terus berkembang terbuka.
                  </p>
                </div>
              </div>

              <div class="mission-step-item">
                <div class="step-badge">03</div>
                <div class="step-content">
                  <h4 class="step-title">Solusi Praktis Dunia Pendidikan & Industri</h4>
                  <p class="step-desc">
                    Menjembatani inovasi frontier AI ke laboratorium praktikum kampus, SMK teknologi informasi, hingga automasi pintar meja kerja korporat modern.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         HALAMAN 3: FOUNDER & TIM REKAYASA (WARNA: KUNING 🟡)
         ======================================================== -->
    <section class="page-section section-yellow" id="tim">
      <div class="about-container">
        <div class="section-header">
          <span class="brutal-badge badge-dark">02 / DI BALIK LAYAR</span>
          <h2 class="section-title text-dark">Founder & Rekayasa Studio</h2>
          <p class="section-desc text-dark-sub">
            Dedikasi memadukan riset mikrokontroler embedded, arsitektur distributed software, dan interaksi cerdas manusia-mesin.
          </p>
        </div>

        <div class="founder-team-grid">
          <!-- Founder Card -->
          <div class="light-card founder-card">
            <div class="founder-header">
              <div class="founder-avatar">
                <span class="avatar-text">IR</span>
              </div>
              <div class="founder-identity">
                <span class="founder-badge">FOUNDER & LEAD ARCHITECT</span>
                <h3 class="founder-name">Franklin Irsyad</h3>
                <p class="founder-role">Lead Hardware & Software Architect • Founder IrsyadLabs</p>
              </div>
            </div>

            <div class="skills-pill-row">
              <span class="skill-pill">ESP32-S3 Embedded</span>
              <span class="skill-pill">Edge AI & Audio DSP</span>
              <span class="skill-pill">Distributed Cloud Architecture</span>
              <span class="skill-pill">Pelopor Xiaozhi Indonesia</span>
            </div>

            <p class="founder-bio-text">
              Merintis riset sistem IoT, arsitektur distributed computing, dan rekayasa firmware mikrokontroler. Mengembangkan Xichi dari eksperimen breadboard di meja kerja hingga menjadi ekosistem produk utuh yang mencakup hardware fisik, web flashing tool, mobile BLE companion, dan katalog 47 alat cerdas terintegrasi.
            </p>

            <div class="founder-actions">
              <a href="https://irsyadlabs.id" target="_blank" rel="noopener noreferrer" class="btn-brutal btn-black-sm">
                <span>Portfolio irsyadlabs.id</span>
                <span class="arrow-icon" aria-hidden="true">↗</span>
              </a>
              <a href="https://github.com/Franklnir" target="_blank" rel="noopener noreferrer" class="btn-brutal btn-outline-dark-sm">
                <span>GitHub Repositori</span>
                <span class="arrow-icon" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <!-- Studio Divisions Card -->
          <div class="light-card divisions-card">
            <div class="divisions-top">
              <span class="founder-badge">FOKUS UTAMA</span>
              <h3 class="divisions-heading">3 Pilar Riset Studio IrsyadLabs</h3>
            </div>

            <div class="division-items">
              <div class="division-item">
                <div class="division-icon-box">⚙️</div>
                <div class="division-text">
                  <h4 class="division-name">Hardware Prototyping & 3D Design</h4>
                  <p class="division-desc">
                    Perancangan skema PCB terpadu, pemilihan komponen audio I2S amplifier berkualitas, manajemen termal chip ESP32, dan casing modular presisi.
                  </p>
                </div>
              </div>

              <div class="division-item">
                <div class="division-icon-box">🧠</div>
                <div class="division-text">
                  <h4 class="division-name">Voice AI Pipeline & Semantic Memory</h4>
                  <p class="division-desc">
                    Optimasi kompresi audio Opus, penanganan audio buffering bebas jeda, dan arsitektur memori semantik untuk dialog kontekstual jangka panjang.
                  </p>
                </div>
              </div>

              <div class="division-item">
                <div class="division-icon-box">🌐</div>
                <div class="division-text">
                  <h4 class="division-name">Komunitas & Ekosistem Terbuka</h4>
                  <p class="division-desc">
                    Kolaborasi terbuka dengan komunitas Xiaozhi Indonesia dan developer open-source untuk pembaruan fitur berkelanjutan dan standarisasi tools MCP.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         HALAMAN 4: SOLUSI KEMITRAAN B2B & KAMPUS (WARNA: HITAM ⚫)
         ======================================================== -->
    <section class="page-section section-black" id="b2b">
      <div class="about-container">
        <div class="section-header">
          <span class="brutal-badge badge-yellow">03 / KEMITRAAN & SOLUSI B2B</span>
          <h2 class="section-title text-light">Kemitraan untuk Institusi & Industri</h2>
          <p class="section-desc text-muted">
            Kerjasama pengadaan terstruktur, integrasi kustom, dan riset teknologi bersama instansi Anda.
          </p>
        </div>

        <!-- Explainer Card: Apa itu B2B -->
        <div class="b2b-explainer-card">
          <div class="explainer-icon">💡</div>
          <div class="explainer-content">
            <h3 class="explainer-title">Apa itu Kemitraan B2B (Business-to-Business)?</h3>
            <p class="explainer-text">
              <strong>B2B</strong> adalah model kemitraan langsung antara <strong>IrsyadLabs</strong> dengan <strong>institusi pendidikan (Universitas, Institut, Politeknik, SMK), laboratorium riset, perkantoran modern, maupun perusahaan</strong> yang membutuhkan pengadaan perangkat dalam jumlah tertentu, integrasi software internal khusus, atau transfer keahlian teknologi Physical AI.
            </p>
          </div>
        </div>

        <!-- 4 B2B Offerings Grid -->
        <div class="b2b-cards-grid">
          <!-- Offering 1 -->
          <div class="dark-card b2b-card">
            <div class="b2b-number">01</div>
            <span class="b2b-tag">EDUKASI & PRAKTIKUM</span>
            <h3 class="b2b-card-title text-light">Lab Starter Pack: Kampus & SMK Vokasi</h3>
            <p class="b2b-card-desc text-stone">
              Pengadaan unit kit riset Xichi untuk laboratorium praktikum IoT, teknik komputer, mekatronika, dan sains data.
            </p>
            <ul class="b2b-features-list">
              <li>✓ Unit siap pakai atau kit komponen edukasi perakitan mandiri</li>
              <li>✓ Skema rangkaian, source code firmware C++/ESP-IDF, dan modul praktikum</li>
              <li>✓ Sesi webinar / workshop teknis langsung bersama lead engineer IrsyadLabs</li>
              <li>✓ Bebas dikembangkan sebagai objek skripsi, tesis, dan riset publikasi ilmiah</li>
            </ul>
            <div class="b2b-target-box">Target: Universitas, Institut Teknologi, SMK Rekayasa Perangkat Keras</div>
          </div>

          <!-- Offering 2 (Highlight) -->
          <div class="dark-card b2b-card card-highlight">
            <div class="populer-ribbon">POPULER</div>
            <div class="b2b-number highlight-num">02</div>
            <span class="b2b-tag">KANTOR & PRODUKTIVITAS</span>
            <h3 class="b2b-card-title text-light">Custom Voice AI untuk Meja Kerja Kantor</h3>
            <p class="b2b-card-desc text-stone">
              Asisten suara fisik personal untuk kebutuhan internal kantor, meja kerja direksi, studio startup, atau front desk.
            </p>
            <ul class="b2b-features-list">
              <li>✓ Penyesuaian basis pengetahuan khusus dokumen internal SOP perusahaan</li>
              <li>✓ Integrasi ke bot notifikasi meeting & monitoring status server internal</li>
              <li>✓ Pemutar audio pengumuman internal kantor melalui speaker meja</li>
              <li>✓ Privasi terjamin dengan isolasi data dan kendali lokal</li>
            </ul>
            <div class="b2b-target-box">Target: Tech Company, Startup Studio, Coworking Space, Kantor Modern</div>
          </div>

          <!-- Offering 3 -->
          <div class="dark-card b2b-card">
            <div class="b2b-number">03</div>
            <span class="b2b-tag">IOT & SMART BUILDING</span>
            <h3 class="b2b-card-title text-light">Automasi Gedung & Smart Home Multi-Relay</h3>
            <p class="b2b-card-desc text-stone">
              Integrasi asisten suara fisik dengan jaringan saklar listrik nyata, tata cahaya ruangan, dan sensor otomasi.
            </p>
            <ul class="b2b-features-list">
              <li>✓ Integrasi kontrol modul Dual Relay ESP32-S3 via perintah suara bahasa Indonesia</li>
              <li>✓ Dukungan protokol MQTT lokal berkecepatan tinggi tanpa hambatan delay internet luar</li>
              <li>✓ Kompatibel dengan instalasi kelistrikan pintar gedung & ruang kerja</li>
              <li>✓ Pemantauan status saklar real-time dari dasbor antarmuka web</li>
            </ul>
            <div class="b2b-target-box">Target: Pengembang Properti Pintar, Kontraktor IoT, Studio Desain Interior</div>
          </div>

          <!-- Offering 4 -->
          <div class="dark-card b2b-card">
            <div class="b2b-number">04</div>
            <span class="b2b-tag">KUSTOMISASI MERK</span>
            <h3 class="b2b-card-title text-light">OEM & Custom Hardware Branding</h3>
            <p class="b2b-card-desc text-stone">
              Produksi unit asisten AI fisik dengan penyesuaian bentuk casing, logo merk klien, dan persona suara kustom.
            </p>
            <ul class="b2b-features-list">
              <li>✓ Kustomisasi casing 3D print berlogo identitas korporat instansi Anda</li>
              <li>✓ Pembuatan wake-word / sapaan nama khusus instansi Anda</li>
              <li>✓ Pengemasan merchandise teknologi eksklusif untuk cinderamata VIP</li>
              <li>✓ Garansi perangkat keras dan dukungan pembaruan firmware berkala</li>
            </ul>
            <div class="b2b-target-box">Target: Brand Korporat, Komunitas Eksekutif, Penyelenggara Event Teknologi</div>
          </div>
        </div>

        <!-- 4-Step Practical Collaboration Process -->
        <div class="dark-process-card">
          <div class="process-card-header">
            <span class="brutal-badge badge-yellow">METODOLOGI</span>
            <h3 class="process-card-title">Alur Kerjasama Praktis 4 Langkah</h3>
            <p class="process-card-subtitle">Proses kemitraan transparan, terukur, dan didampingi langsung oleh tim engineering.</p>
          </div>

          <div class="process-grid">
            <div class="process-step">
              <div class="step-circle">1</div>
              <h4 class="step-name">Konsultasi Awal</h4>
              <p class="step-summary">Diskusikan kebutuhan spesifik unit, modul kurikulum lab, atau fitur AI khusus instansi Anda.</p>
            </div>

            <div class="process-step">
              <div class="step-circle">2</div>
              <h4 class="step-name">Demo & Proposal</h4>
              <p class="step-summary">Tim IrsyadLabs menyusun simulasi solusi teknis, spesifikasi hardware, dan estimasi waktu perakitan.</p>
            </div>

            <div class="process-step">
              <div class="step-circle">3</div>
              <h4 class="step-name">Perakitan & QC</h4>
              <p class="step-summary">Perangkat dirakit dengan presisi, diuji latensi audio dan kestabilan mikrokontroler sebelum serah terima.</p>
            </div>

            <div class="process-step">
              <div class="step-circle">4</div>
              <h4 class="step-name">Dukungan & Pelatihan</h4>
              <p class="step-summary">Pengiriman unit disertai dokumentasi lengkap, panduan setup, dan pendampingan teknis berkelanjutan.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         HALAMAN 5: HUBUNGI & KONSULTASI B2B (WARNA: KUNING 🟡)
         ======================================================== -->
    <section class="page-section section-yellow" id="kontak">
      <div class="about-container">
        <div class="contact-cta-wrapper">
          <div class="contact-info-col">
            <span class="brutal-badge badge-dark">DISKUSIKAN KEBUTUHAN INSTITUSI ANDA</span>
            <h2 class="contact-heading">Siap Berkolaborasi Bersama IrsyadLabs?</h2>
            <p class="contact-intro">
              Apakah Anda membutuhkan pengadaan 10 unit kit lab praktikum kampus, integrasi khusus asisten kantor, atau kustomisasi hardware AI fisik? Tim kami siap berdiskusi langsung dengan Anda.
            </p>

            <div class="contact-pills-list">
              <div class="contact-card-item">
                <span class="contact-item-icon">📍</span>
                <div>
                  <strong>Lokasi Riset & Studio:</strong>
                  <p>Bandung, Jawa Barat, Indonesia</p>
                </div>
              </div>

              <div class="contact-card-item">
                <span class="contact-item-icon">✉️</span>
                <div>
                  <strong>Email Resmi Kemitraan:</strong>
                  <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
                </div>
              </div>

              <div class="contact-card-item">
                <span class="contact-item-icon">📞</span>
                <div>
                  <strong>WhatsApp Tim Engineering:</strong>
                  <p><a href={`https://wa.me/${siteConfig.whatsappNumber}?text=${b2bWhatsappMessage}`} target="_blank" rel="noopener noreferrer">+62 896-5825-2277</a></p>
                </div>
              </div>

              <div class="contact-card-item">
                <span class="contact-item-icon">⚡</span>
                <div>
                  <strong>Waktu Respon:</strong>
                  <p>Cepat (Dalam 1 x 24 Jam Hari Kerja)</p>
                </div>
              </div>
            </div>
          </div>

          <div class="contact-action-col">
            <div class="action-card-box">
              <span class="action-tag">FAST TRACK VIA WHATSAPP</span>
              <h3>Mulai Diskusi Kemitraan Sekarang</h3>
              <p>Konsultasikan kebutuhan teknis atau permintaan proposal penawaran resmi secara langsung.</p>

              <div class="action-buttons-group">
                <a
                  href={`https://wa.me/${siteConfig.whatsappNumber}?text=${b2bWhatsappMessage}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-brutal btn-black btn-block"
                >
                  <span>📲 Hubungi via WhatsApp</span>
                  <span class="arrow-icon" aria-hidden="true">→</span>
                </a>

                <a
                  href={`mailto:${siteConfig.email}?subject=Permohonan%20Kemitraan%20B2B%20-%20Xichi%20AI&body=Halo%20tim%20IrsyadLabs,%0A%0ASaya%20tertarik%20untuk%20mengetahui%20lebih%20lanjut%20mengenai%20solusi%20kemitraan%20B2B/edukasi%20untuk%20instansi%20kami.`}
                  class="btn-brutal btn-white btn-block"
                >
                  <span>✉️ Kirim Email Kerjasama</span>
                  <span class="arrow-icon" aria-hidden="true">↗</span>
                </a>

                <a href="/#products" class="btn-brutal btn-outline-dark btn-block">
                  <span>← Kembali ke Showcase Produk</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ============================================================
     TENTANG.ASTRO - ALTERNATING NEO-BRUTALIST COLOR THEME
     Cadence:
     - Section 1 (Hero + Stats):  🟡 KUNING (#FFE600)
     - Section 2 (Visi & Misi):   ⚫ HITAM  (#0B0B0A)
     - Section 3 (Founder & Tim): 🟡 KUNING (#FFE600)
     - Section 4 (Solusi B2B):    ⚫ HITAM  (#0B0B0A)
     - Section 5 (Kontak & CTA):  🟡 KUNING (#FFE600)
     - Footer (Sudah Bawaan):     ⚫ HITAM  (#0B0B0A)
     ============================================================ */

  .about-page {
    padding-top: var(--nav-height);
    background: #0b0b0a;
    min-height: 100vh;
  }

  .about-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Base Section Structure */
  .page-section {
    padding: clamp(70px, 8vw, 110px) 0;
    border-bottom: 3px solid #000000;
