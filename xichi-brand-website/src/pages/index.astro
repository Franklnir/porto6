---
// index.astro - Xichi Physical AI Assistant Landing Page
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ProductsSection from '../components/ProductsSection.astro';
import VoiceSection from '../components/VoiceSection.astro';
import ToolsSection from '../components/ToolsSection.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import CultureSection from '../components/CultureSection.astro';
import ChronchiSection from '../components/ChronchiSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <Marquee />
    <ProductsSection />
    <CultureSection />
    <VoiceSection />
    <ToolsSection />
    <ComparisonSection />
    <ChronchiSection />
    <FAQSection />
  </main>
  <Footer />
</BaseLayout>
