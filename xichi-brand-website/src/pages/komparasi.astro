---
// komparasi.astro - Dedicated Comparison Page (Xichi vs Conventional Smart Speakers)
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={`Komparasi: Xichi vs Google Nest & Alexa | ${siteConfig.name}`}
  description="Bandingkan keunggulan Xichi Physical AI dengan speaker pintar konvensional seperti Google Nest dan Amazon Alexa: bebas langganan YouTube, dialog fleksibel, dan integrasi BMKG lokal."
>
  <Navbar />
  <main id="main-content" style="padding-top: 80px;">
    <ComparisonSection />
  </main>
  <Footer />
</BaseLayout>
